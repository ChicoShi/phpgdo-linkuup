+<?php
+declare(strict_types=1);
+if(PHP_SAPI!=='cli')exit(1);
+require __DIR__.'/../Server/GWS_SessionBinding.php';
+require __DIR__.'/../Server/GWS_Message.php';
+use GDO\Websocket\Server\GWS_SessionBinding as Binding;
+use GDO\Websocket\Server\GWS_Message as Message;
+$checks=0;
+function check($v){global $checks;if(!$v)throw new RuntimeException('Assertion failed');$checks++;}
+function denied(callable $f){try{$f();throw new LogicException('Unexpected acceptance');}catch(RuntimeException $e){check(in_array($e->getCode(),[403,503],true));}}
+$session=['sess_id'=>'1','sess_user'=>'7','sess_token'=>'synthetic-A','sess_auth'=>str_repeat('a',32),'sess_time'=>gmdate('Y-m-d H:i:s')];
+$user=['user_id'=>'7','user_deleted'=>null];
+$a=Binding::snapshot($session);Binding::verify($a,$session,$user,3600);check(true);
+$b=$session;$b['sess_id']='2';$b['sess_token']='synthetic-B';$boundB=Binding::snapshot($b);
+$revoked=$session;$revoked['sess_user']=null;$revoked['sess_auth']=str_repeat('b',32);
+denied(fn()=>Binding::verify($a,$revoked,$user));
+Binding::verify($boundB,$b,$user);check(true);
+$relogin=$session;$relogin['sess_auth']=str_repeat('c',32);denied(fn()=>Binding::verify($a,$relogin,$user));
+$deleted=$user;$deleted['user_deleted']='2026-01-01';denied(fn()=>Binding::verify($a,$session,$deleted));
+denied(fn()=>Binding::verify($a,null,$user));
+$expired=$session;$expired['sess_time']='2000-01-01';denied(fn()=>Binding::verify($a,$expired,$user,3600));
+$foreign=$user;$foreign['user_id']='8';denied(fn()=>Binding::verify($a,$session,$foreign));
+$guest=$session;$guest['sess_user']=null;Binding::verify(Binding::snapshot($guest),$guest,null);check(true);
+$conn=new class {public array $sent=[];public function send($p){$this->sent[]=['text',$p];return true;}public function sendBinary($p){$this->sent[]=['binary',$p];return true;}public function user(){return false;}};
+$m=new Message("\x01\x05",$conn);$m->readCmd();$m->deferReplies();$m->replyText(261,'first');$m->replyBinary(261,'second');check($conn->sent===[]);
+$m->discardReplies();$m->flushReplies();check($conn->sent===[]);
+$m->deferReplies();$m->replyText(261,'first');$m->replyBinary(261,'second');$m->flushReplies();check(count($conn->sent)===2&&$conn->sent[0][0]==='text'&&$conn->sent[1][0]==='binary');
+$m->flushReplies();check(count($conn->sent)===2);
+$m->deferReplies();denied(fn()=>$m->replyText(261,str_repeat('x',65537)));$m->discardReplies();check(count($conn->sent)===2);
+echo json_encode(['checks'=>$checks,'scope'=>'Binding comparisons and actual message buffering with synthetic transport; no live socket, full login or atomic domain-dispatch proof.']),"\n";
